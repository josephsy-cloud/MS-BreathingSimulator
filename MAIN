'use strict';
/* ---------- Pattern configuration (single source of truth) ---------- */
const push=(p,ti,te,a,tag)=>{p.L.push({t0:p.end,ti,te,a,tag});p.end+=ti+te};
const reg=p=>{const c=p.cfg,T=60/c.rate;push(p,T*c.ip,T*(1-c.ip),c.a,'');if(c.tri)p.L[p.L.length-1].tri=1};
const respiratoryPatterns={
eupnea:{n:'Eupnea / Normal Breathing',rate:14,a:.5,ip:.4,eff:0,rr:'12–20 /min',dp:'Normal',rh:'Regular',tb:['Normal','Normal','Regular'],
 ft:'Smooth, even breaths of normal depth',cue:'REGULAR · EVEN · SMOOTH',chg:'NORMAL: regular + consistent depth + consistent timing',gen:reg},
hyperpnea:{n:'Hyperpnea',rate:16,a:.92,ip:.4,eff:.3,rr:'Normal or ↑',dp:'Increased (deep)',rh:'Usually regular',tb:['Normal/↑','↑','Usually regular'],
 ft:'Deeper breaths, larger tidal volume',cue:'DEEPER, NOT NECESSARILY FASTER',chg:'DEPTH ↑',gen:reg},
bradypnea:{n:'Bradypnea',rate:8,a:.5,ip:.38,eff:0,rr:'< 12 /min',dp:'Variable',rh:'Usually regular',tb:['↓','Variable','Usually regular'],
 ft:'Slow rate, long pause between breaths',cue:'SLOW · LONG INTERVALS',chg:'RATE ↓',gen:reg},
tachypnea:{n:'Tachypnea',rate:32,a:.28,ip:.42,eff:0,rr:'> 20 /min',dp:'Often shallow',rh:'Usually regular',tb:['↑','Often ↓','Usually regular'],
 ft:'Rapid, often shallow breaths',cue:'FAST · CLOSELY SPACED',chg:'RATE ↑',gen:reg},
apnea:{n:'Apnea',rate:0,a:0,eff:0,rr:'Absent',dp:'None',rh:'No breathing',tb:['Absent','None','No breathing'],
 ft:'Absence of respiratory movement',cue:'NO RESPIRATORY MOVEMENT',chg:'BREATHING ABSENT',gen:p=>{p.end+=10}},
cheyne:{n:'Cheyne-Stokes',rate:null,a:1,eff:.2,rr:'Variable',dp:'Crescendo–decrescendo',rh:'Periodic',tb:['Variable','Crescendo-decrescendo','Periodic'],
 ft:'Breaths grow deeper, then shallower, then stop',cue:'INCREASE → DECREASE → STOP → REPEAT',chg:'DEPTH WAXES → WANES + APNEA',
 gen:p=>{const n=8;for(let i=0;i<n;i++)push(p,.75,1.05,.06+.94*Math.sin(Math.PI*(i+.5)/n),i<n/2?'CRESCENDO':'DECRESCENDO');p.end+=7}},
biot:{n:'Biot Respirations',rate:null,a:1,eff:.2,rr:'Variable',dp:'Irregular',rh:'Irregular clusters + apnea',tb:['Variable','Irregular','Irregular clusters + apnea'],
 ft:'Irregular breath clusters with sudden pauses',cue:'CLUSTER → SUDDEN STOP → CLUSTER',chg:'IRREGULAR CLUSTERS + APNEA',
 gen:p=>{const r=p.rng,k=3+(r()*3|0);for(let i=0;i<k;i++)push(p,.7+r()*.6,i==k-1?.08:1+r()*1.2,.2+r()*.7,'BREATH CLUSTER');p.end+=4+r()*8}},
kussmaul:{n:'Kussmaul Respirations',rate:28,a:1,ip:.5,tri:1,eff:1,rr:'↑ (rapid)',dp:'Very deep',rh:'Regular, rapid, labored',tb:['↑','Deep','Regular/rapid/labored'],
 ft:'Deep + rapid + labored breathing',cue:'DEEP + RAPID + LABORED',chg:'DEEP + RAPID + LABORED',gen:reg}
};
const KEYS=Object.keys(respiratoryPatterns);

/* ---------- Shared respiratory engine ---------- */
const rngOf=a=>()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
function initSim(p,key){p.key=key;p.cfg=respiratoryPatterns[key];p.L=[];p.end=-30;p.rng=rngOf(key.length*7919+12345);p.gv=0;ensure(p,2)}
function ensure(p,upTo){let g=0;while(p.end<upTo&&g++<500)p.cfg.gen(p)}
function find(L,t){let lo=0,hi=L.length-1,i=-1;while(lo<=hi){const m=(lo+hi)>>1;if(L[m].t0<=t){i=m;lo=m+1}else hi=m-1}return i}
function shape(b,t){const x=t-b.t0;if(x<=0||x>=b.ti+b.te)return 0;
 const u=x<b.ti?x/b.ti:1-(x-b.ti)/b.te;return b.a*(b.tri?u:x<b.ti?(1-Math.cos(Math.PI*u))/2:(1+Math.cos(Math.PI*(1-u)))/2)}
const depthAt=(p,t)=>{const i=find(p.L,t);return i<0?0:shape(p.L[i],t)};
function phaseAt(p,t){const i=find(p.L,t);if(i<0)return['APNEA','',0];const b=p.L[i],x=t-b.t0;
 if(x>=b.ti+b.te)return['APNEA','',0];const s=x<b.ti?'INSPIRATION':'EXPIRATION';return[b.tag||s,b.tag?s.toLowerCase():'',b.a]}

/* ---------- Patient illustration ---------- */
let uid=0;
function mkPatient(host){const u=++uid,cx=200,P='#f4c3ba',L='M0 0C22 -4 34 28 34 66C34 96 20 118 0 118C-22 118 -34 100 -34 68C-34 30 -22 -2 0 0Z',TR='M234 78Q206 80 200 104L200 204';
host.innerHTML=`<svg viewBox="0 0 400 450" role="img" aria-label="Patient anatomy showing airway, lungs, ribs and diaphragm">
<rect x="176" y="90" width="42" height="50" fill="${P}"/>
<ellipse cx="196" cy="60" rx="40" ry="48" fill="${P}"/><path d="M228 58L248 80L228 88Z" fill="${P}"/>
<path id="t${u}" fill="${P}"/>
<path id="m${u}" stroke="#b4470f" stroke-width="6" fill="none" stroke-linecap="round"/>
<path d="${TR}" stroke="#f4506d" stroke-width="13" fill="none" stroke-linecap="round"/>
<path d="${TR}" stroke="#7fd6f0" stroke-width="3" fill="none"/>
<g id="lg${u}"><path d="${L}" fill="#f4506d"/><path d="${L}" fill="#f4506d"/></g>
<path d="M200 204Q184 210 166 232M200 204Q216 210 234 232M178 218L172 262M222 218L228 262M170 236L156 258M230 236L244 258" stroke="#7fd6f0" stroke-width="3" fill="none" stroke-linecap="round"/>
<path id="r${u}" stroke="#f0a696" stroke-width="10" fill="none" stroke-linecap="round"/>
<path id="rd${u}" stroke="#fff6ea" stroke-width="6" stroke-dasharray="0.1 13" fill="none" stroke-linecap="round"/>
<path id="d${u}" stroke="#a020c8" stroke-width="7" fill="none" stroke-linecap="round"/>
<path id="da${u}" stroke="#a020c8" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
<path id="n${u}" stroke="#2fa8dc" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
<text id="x${u}" x="200" y="440" text-anchor="middle" font-size="20" font-weight="800" font-family="Segoe UI,Arial"></text></svg>`;
const q=id=>host.querySelector('#'+id+u),T=q('t'),LG=q('lg'),R=q('r'),RD=q('rd'),M=q('m'),D=q('d'),DA=q('da'),N=q('n'),X=q('x');let lastMsg='';
return{set(d,eff,apn,ins){
 const l=d*(3+5*eff),hc=94+28*d,ha=80+18*d,y=142-l;
 T.setAttribute('d',`M${cx-16} 112C${cx-60} 116 ${cx-116} 118 ${cx-136} ${y}C${cx-hc-6} 172 ${cx-hc} 190 ${cx-hc} 218C${cx-hc} 258 ${cx-ha} 272 ${cx-ha} 312C${cx-ha} 350 ${cx-90} 376 ${cx-90} 424L${cx+90} 424C${cx+90} 376 ${cx+ha} 350 ${cx+ha} 312C${cx+ha} 272 ${cx+hc} 258 ${cx+hc} 218C${cx+hc} 190 ${cx+hc+6} 172 ${cx+136} ${y}C${cx+116} 118 ${cx+60} 116 ${cx+16} 112Z`);
 const rb=`M${cx-hc+14} 168Q${cx-hc+6} 250 ${cx-hc+22} 326M${cx+hc-14} 168Q${cx+hc-6} 250 ${cx+hc-22} 326`;R.setAttribute('d',rb);RD.setAttribute('d',rb);
 M.setAttribute('d',`M${cx-14} 100L${cx-30} ${130-l}M${cx+14} 100L${cx+30} ${130-l}`);M.setAttribute('opacity',Math.min(1,eff*d*1.6));
 [-1,1].forEach((s,i)=>LG.children[i].setAttribute('transform',`translate(${cx+s*48} ${198-4*d}) scale(${1+.3*d} ${1+.16*d})`));
 const ye=330+8*d,h=24-14*d,dx=hc-26;
 D.setAttribute('d',`M${cx-dx} ${ye}Q${cx} ${ye-2*h} ${cx+dx} ${ye}`);
 const s=ins?1:-1,y0=356+8*d;let a='';for(const x of[-32,0,32])a+=`M${cx+x} ${y0}L${cx+x} ${y0+s*16}M${cx+x-6} ${y0+s*9}L${cx+x} ${y0+s*17}L${cx+x+6} ${y0+s*9}`;
 DA.setAttribute('d',a);
 const x0=ins?286:258,x1=ins?258:286,dr=Math.sign(x1-x0);let n='';for(const yy of[70,90])n+=`M${x0} ${yy}L${x1} ${yy}M${x1-dr*9} ${yy-6}L${x1} ${yy}L${x1-dr*9} ${yy+6}`;
 N.setAttribute('d',n);DA.setAttribute('opacity',apn?0:1);N.setAttribute('opacity',apn?0:1);
 const msg=apn?'NO RESPIRATORY MOVEMENT':ins?'BREATHING IN':'BREATHING OUT';
 if(msg!==lastMsg){lastMsg=msg;X.textContent=msg;X.setAttribute('fill',apn?'#c2410c':ins?'#0b6f7a':'#0d2230')}}}}

/* ---------- Waveform ---------- */
const WIN=30;
function drawWave(p,t){const c=p.cv,dpr=window.devicePixelRatio||1,w=c.clientWidth,h=c.clientHeight;if(!w||!h)return;
 if(c.width!==(w*dpr|0)||c.height!==(h*dpr|0)){c.width=w*dpr|0;c.height=h*dpr|0}
 const g=c.getContext('2d');g.setTransform(dpr,0,0,dpr,0,0);g.clearRect(0,0,w,h);
 const base=h*.86,H=h*.66,px=w/WIN;
 g.lineWidth=1;
 for(let k=Math.ceil(t-WIN);k<=t;k++){const x=w-(t-k)*px;g.strokeStyle=k%5===0?'rgba(0,0,0,.22)':'rgba(0,0,0,.07)';g.beginPath();g.moveTo(x,0);g.lineTo(x,h);g.stroke()}
 g.strokeStyle='rgba(0,0,0,.07)';for(let i=1;i<5;i++){const y=h*i/5;g.beginPath();g.moveTo(0,y);g.lineTo(w,y);g.stroke()}
 g.setLineDash([6,6]);g.strokeStyle='rgba(0,0,0,.3)';g.beginPath();g.moveTo(0,base);g.lineTo(w,base);g.stroke();g.setLineDash([]);
 g.strokeStyle='#1db36f';g.lineWidth=3.5;g.lineJoin='round';g.beginPath();
 for(let x=0;x<=w;x+=2){const d=depthAt(p,t-WIN+x/px);const y=base-d*H;x?g.lineTo(x,y):g.moveTo(x,y)}
 g.stroke();
 g.fillStyle='#0d2230';g.font=`700 ${Math.max(14,w/38)|0}px Segoe UI,Arial`;
 const r=p.cfg.rate===null?'VARIABLE':p.cfg.rate+' /min';
 g.fillText(`RESP · ${p.cfg.n} · ${r}`,12,26);
 g.fillStyle='rgba(13,34,48,.65)';g.font=`600 ${Math.max(12,w/52)|0}px Segoe UI,Arial`;g.fillText('inspiration ↑  expiration ↓   |   grid: 1 s / 5 s',12,h-10)}

/* ---------- App state ---------- */
const $=s=>document.querySelector(s);
let currentPattern='eupnea',simulationTime=0,isPlaying=true,cmp=false,last=0;
const mk=(id)=>{const el=$(id);const p={el,cv:el.querySelector('canvas'),st:el.querySelector('.st'),pt:mkPatient(el.querySelector('.host'))};return p};
const pA=mk('#pA'),pB=mk('#pB');
const cache={};const setT=(id,v)=>{if(cache[id]!==v){cache[id]=v;$('#'+id).textContent=v}};
const depthLabel=g=>g<.05?'NONE':g<.38?'LOW':g<.66?'NORMAL':'HIGH';

function resetSimulation(){stopSounds();simulationTime=0;initSim(pA,'eupnea');initSim(pB,currentPattern)}
function selectPattern(k){currentPattern=k;const c=respiratoryPatterns[k];
 setT('pname',c.n);setT('chg',c.chg==='NORMAL: regular + consistent depth + consistent timing'?c.chg:'Changed from eupnea: '+c.chg);
 setT('sR',c.rr);setT('sD',c.dp);setT('sH',c.rh);setT('sF',c.ft);setT('cue',c.cue);setT('lN',c.n);setT('lH',c.rh);
 setT('lR',c.rate===null?'VARIABLE':c.rate+' /min');
 pB.el.querySelector('.pl').textContent='Selected pattern: '+c.n;
 document.querySelectorAll('#tb tr').forEach(r=>r.className=r.dataset.k===k?'on':'');
 resetSimulation()}
function togglePresentationMode(){const on=document.documentElement.classList.toggle('pres');$('#bPres').setAttribute('aria-pressed',on)}
const setPlay=v=>{isPlaying=v;if(ac)v?ac.resume():ac.suspend();$('#bPlay').setAttribute('aria-pressed',v);$('#bPause').setAttribute('aria-pressed',!v)};
const flag=(btn,cls,inv)=>{const b=$(btn);b.addEventListener('click',()=>{const on=b.getAttribute('aria-pressed')!=='true';b.setAttribute('aria-pressed',on);document.body.classList.toggle(cls,inv?!on:on);})};

function stats(p){const c=p.cfg,r=c.rate===null?'VARIABLE':c.rate+' /min';return`Rate: ${r} · Depth: ${c.dp} · Rhythm: ${c.rh}`}

function frame(ts){
 const dt=Math.min(.1,(ts-last)/1000||0);last=ts;if(isPlaying)simulationTime+=dt;const t=simulationTime;
 for(const p of [pA,pB]){if(p===pA&&!cmp)continue;
  ensure(p,t+1);const d=depthAt(p,t),ph=phaseAt(p,t);
  p.pt.set(d,p.cfg.eff,ph[0]==='APNEA',ph[1]?ph[1]==='inspiration':ph[0]==='INSPIRATION');drawWave(p,t);
  if(cmp)p.st.textContent=stats(p);
  if(p===pB){
   const bi=find(p.L,t),bb=bi<0?null:p.L[bi],bx=bb?t-bb.t0:-1;let k=-1;
   if(bb&&bx<bb.ti+bb.te)k=bi*2+(bx<bb.ti?0:1);
   if(k!==lastK){lastK=k;if(soundOn&&bufs&&isPlaying&&k>=0){const e=k%2;if((e?bx-bb.ti:bx)<.3)playBreath(e?'e':'i',e?bb.te:bb.ti,bb.a)}}
   p.gv+=(ph[2]-p.gv)*Math.min(1,dt*6);
   setT('ph',ph[0]);setT('phs',ph[1]?ph[1].charAt(0).toUpperCase()+ph[1].slice(1):' ');
   setT('lD',depthLabel(p.gv));$('#mk').style.left=(Math.min(1,p.gv)*100).toFixed(1)+'%'}}
 requestAnimationFrame(frame)}

/* ---------- Breathing sound (clips from Inhale_Exhale.mp4; speed + volume follow the waveform) ---------- */
const SND_B64={"i": ["", ""], "e": ["", ""]};
let ac=null,mg=null,bufs=null,soundOn=false,lastK=-1,srcs=[];
async function initAudio(){if(ac)return;ac=new(window.AudioContext||window.webkitAudioContext)();mg=ac.createGain();mg.gain.value=$('#vol').value/100;mg.connect(ac.destination);
 const dec=b=>ac.decodeAudioData(Uint8Array.from(atob(b),c=>c.charCodeAt(0)).buffer);
 bufs={i:await Promise.all(SND_B64.i.map(dec)),e:await Promise.all(SND_B64.e.map(dec))}}
function stopSounds(){srcs.forEach(s=>{try{s.stop()}catch(e){}});srcs=[];lastK=-1}
function playBreath(kind,dur,amp){if(dur<.25)return;
 const arr=bufs[kind],b=arr[Math.random()*arr.length|0],s=ac.createBufferSource(),g=ac.createGain();
 const rate=Math.min(1.8,Math.max(.6,b.duration/dur)),vol=.1+.9*Math.pow(Math.min(1,amp),.8);
 s.buffer=b;s.playbackRate.value=rate;
 const now=ac.currentTime,len=Math.min(dur,b.duration/rate);
 g.gain.setValueAtTime(vol,now);g.gain.setValueAtTime(vol,now+Math.max(0,len-.1));g.gain.linearRampToValueAtTime(0,now+len);
 s.connect(g);g.connect(mg);s.start(now);s.stop(now+len+.05);srcs.push(s);s.onended=()=>{srcs=srcs.filter(x=>x!==s)}}

